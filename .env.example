# CartCompass-BI Environment Configuration Example
# Copy this file to .env and adjust values for your environment

FLASK_APP=backend.app:app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=cartcompass-dev-secret-key-change-in-production-123456
PORT=5000
HOST=127.0.0.1

# SQLite Database Path (relative to project root or absolute path)
DATABASE_PATH=cartcompass.db

# Default Currency Symbol (INR = ₹, USD = $)
DEFAULT_CURRENCY=₹
